// FMRRE - build inside an AOSP / LineageOS / TWRP-minimal-manifest tree.
//
// Clone this repo to bootable/fmrre (or anywhere in the tree) and add
//     PRODUCT_PACKAGES += fmrre_recovery
// to your device makefile. The module installs as /system/bin/recovery inside
// the recovery ramdisk and replaces the stock recovery UI.

cc_binary {
    name: "fmrre_recovery",
    stem: "recovery",
    recovery: true,
    static_executable: true,
    overrides: ["recovery"],

    srcs: [
        "src/**/*.cpp",
        "third_party/miniz/miniz.c",
        "third_party/xz/*.c",
    ],
    local_include_dirs: [
        "src",
        "third_party/stb",
        "third_party/miniz",
        "third_party/xz",
    ],
    cflags: [
        "-DMINIZ_NO_ZLIB_COMPATIBLE_NAMES",
        "-D_FILE_OFFSET_BITS=64",
        "-DTW_BUILD_DATE=\"aosp\"",
        "-Wno-unused-parameter",
        "-Wno-missing-field-initializers",
        "-Wno-sign-compare",
        "-Wno-unused-function",
        "-Wno-#pragma-messages",
    ],
    cppflags: ["-fexceptions"],
    stl: "libc++_static",
}
